#!/usr/bin/env bash
# Hand github-mcp-server a GitHub token without keeping one on disk.
#
# The server reads its credential only from GITHUB_PERSONAL_ACCESS_TOKEN and has
# no flag for fetching one from a command, so registering it with Claude Code
# would otherwise mean writing a long-lived token into ~/.claude.json. Resolving
# it here, once per server launch, keeps the registration credential-free and
# lets a fresh `gh auth login` take effect on the next session instead of
# leaving a revoked token behind in a file nothing re-renders.
#
# Shadowing the real binary on PATH — the same trick ~/.local/bin/gh uses — keeps
# the registration a plain `github-mcp-server stdio`.
set -euo pipefail

nix_bin="/etc/profiles/per-user/${USER:-$(id -un)}/bin"

# Failing here beats starting a server that errors on every tool call: Claude
# Code reports the server as failed and surfaces this line in its MCP log.
if ! token="$("$nix_bin/gh" auth token 2>/dev/null)" || [ -z "$token" ]; then
  echo "github-mcp-server: no GitHub token available — run 'gh auth login'." >&2
  exit 1
fi

GITHUB_PERSONAL_ACCESS_TOKEN="$token" exec "$nix_bin/github-mcp-server" "$@"
