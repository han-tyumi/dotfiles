#!/usr/bin/env nu

const LOCAL_FLAKE_DIR = '~/.config/nix-darwin'
const SYSTEM_FLAKE_DIR = '/etc/nix-darwin'
const SOURCE_FLAKE_LOCK = 'dot_config/nix-darwin/flake.lock'

# Apply Chezmoi state, Nix Darwin config, and tooling updates.
@search-terms "rebuild" "switch" "darwin" "chezmoi" "home-manager" "mise"
@example "Apply everything (chezmoi, switch, update, mise, clean)" { apploi }
@example "Just apply chezmoi state" { apploi -c }
@example "Switch nix-darwin to the latest config" { apploi -s }
@example "Chezmoi apply + switch" { apploi -cs }
@example "Force-refresh overlays, then apply everything" { apploi -R }
export def main [
  --all (-A)      # Apply everything (default if no flags given).
  --chezmoi (-c)  # Apply Chezmoi's state.
  --update (-u)   # Update the nix-darwin flake inputs.
  --switch (-s)   # Switch to the latest nix-darwin configuration.
  --clean (-C)    # Clean the Nix store.
  --mise (-m)     # Upgrade mise plugins and tools.
  --refresh (-R)  # Force-refresh Chezmoi externals (overlays) before applying.
]: nothing -> nothing {
  let all = $all or not ($chezmoi or $update or $switch or $clean or $mise)
  # Overlays refresh on their own once a day; --refresh forces it now (e.g.
  # after pushing a work-overlay change) and implies the chezmoi step.
  let chezmoi = $all or $chezmoi or $refresh
  let update = $all or $update
  let switch = $all or $switch
  let clean = $all or $clean
  let mise = $all or $mise

  let original_dir = (pwd)

  if $chezmoi {
    let source_path = (^chezmoi source-path)
    step $"Changing to ($source_path)\n\n"
    cd $source_path

    # Machines that only receive dotfiles changes stay current through plain
    # apploi. Two states skip the pull rather than fail it: a dirty tree (mid-edit
    # on the authoring machine), and a branch with no upstream, which has nothing to
    # fast-forward from — each says which, since the diverged-origin advice below
    # would discard the work on a local topic branch.
    #
    # The lock is exempt from that dirty check because this run's own update step
    # rewrites it and re-adds it to the source. Counting it would let one flake
    # update stop every later pull until someone committed the bump.
    let branch = (^git rev-parse --abbrev-ref HEAD | str trim)
    let tracked = (do { ^git rev-parse --abbrev-ref --symbolic-full-name '@{u}' } | complete).exit_code == 0
    let lock_excluded = ':(exclude)' + $SOURCE_FLAKE_LOCK
    if (do { ^git diff --quiet HEAD -- . $lock_excluded } | complete).exit_code != 0 {
      step $"Local changes present — skipping pull\n\n"
    } else if not $tracked {
      step $"($branch) has no upstream — skipping pull\n\n"
    } else {
      step $"Pulling the latest dotfiles\n\n"
      # --quiet keeps a no-op pull silent; a non-fast-forward means origin's
      # history was rewritten (an amend + force-push from the authoring
      # machine), so report the one-line fix instead of git's raw output.
      if (do { ^git pull --ff-only --quiet } | complete).exit_code != 0 {
        step $"Pull skipped — origin diverged; resync with: git fetch && git reset --hard origin/($branch)\n\n"
      }
    }

    # Claude Code rewrites its own settings file; a modify_ script
    # (dot_claude/modify_private_settings.json) merges the managed config over
    # the live file on apply, so no capture step is needed here.
    # --keep-going so one failing target (e.g. a corrupt file a modify_ script
    # can't parse) doesn't skip every later target in the apply.
    # --init re-renders ~/.config/chezmoi/chezmoi.toml from the template first,
    # so a pulled change to .chezmoi.toml.tmpl takes effect in this same run
    # rather than warning on every apply until someone runs `chezmoi init`.
    step $"\nApplying Chezmoi's state\n\n"
    if $refresh {
      ^chezmoi apply --keep-going --init --refresh-externals
    } else {
      ^chezmoi apply --keep-going --init
    }
    step ""
  }

  # Quoted strings don't tilde-expand for external commands, so expand here;
  # -sfn also repairs a dangling or wrong link instead of skipping it
  # (-n rather than -h: GNU ln from nix coreutils shadows the BSD one).
  let flake_link_ok = (($SYSTEM_FLAKE_DIR | path type) == 'symlink') and ($SYSTEM_FLAKE_DIR | path exists) and (($SYSTEM_FLAKE_DIR | path expand) == ($LOCAL_FLAKE_DIR | path expand))
  if not $flake_link_ok {
    step $"Linking ($LOCAL_FLAKE_DIR) to ($SYSTEM_FLAKE_DIR)\n\n"
    ^sudo ln -sfn ($LOCAL_FLAKE_DIR | path expand) $SYSTEM_FLAKE_DIR
  }

  step $"Changing to ($SYSTEM_FLAKE_DIR)\n\n"
  cd $SYSTEM_FLAKE_DIR

  if $update {
    step "Updating nix-darwin flake inputs\n\n"
    ^nix flake update

    # A nixpkgs release branch stops moving once the release goes EOL, which
    # makes the update above a silent no-op. Report the age of the pin so a dead
    # channel reads as stale rather than as already current.
    let nixpkgs_locked = (open --raw flake.lock | from json | get nodes.nixpkgs.locked.lastModified)
    let nixpkgs_age = ((date now) - ($nixpkgs_locked * 1_000_000_000 | into datetime))
    if $nixpkgs_age > 30day {
      step $"\nnixpkgs is (($nixpkgs_age // 1day)) days old — bump the channel refs in flake.nix\n\n"
    }

    # nix flake update rewrites the live lock; re-add it so chezmoi's source
    # tracks the new inputs rather than reverting them on the next apply.
    ^chezmoi re-add ~/.config/nix-darwin/flake.lock

    # Surface a captured-but-uncommitted lock change so pinned inputs get
    # committed instead of drifting silently.
    let source_root = (^chezmoi source-path)
    if (do { ^git -C $source_root diff --quiet HEAD -- $SOURCE_FLAKE_LOCK } | complete).exit_code != 0 {
      step $"\nPending flake.lock changes\n\n"
      ^git -C $source_root --no-pager diff HEAD -- $SOURCE_FLAKE_LOCK
    }
  }

  if $switch {
    step "\nApplying nix-darwin configuration\n\n"

    # --no-write-lock-file keeps the root rebuild from re-owning flake.lock,
    # which would make the next user-level `nix flake update` fail with EPERM.
    # Issue with `/tmp` symlink; we use `/private/tmp` directly instead.
    ^sudo TMPDIR=/private/tmp darwin-rebuild switch --no-write-lock-file

    # `brew bundle` only upgrades declared formulae; their dependencies go stale without this.
    # --no-ask skips Homebrew's confirmation prompt so the unattended run doesn't block.
    step "\nUpgrading Homebrew dependency formulae\n\n"
    ^brew upgrade --formula --no-ask
  }

  if $clean {
    step "\nCleaning up Nix store\n\n"

    # --delete-older-than matches the retention the scheduled nix.gc declares, so
    # a manual run leaves the same month of generations to roll back to instead of
    # collapsing to one.
    ^sudo -H nix-collect-garbage --delete-older-than 30d
  }

  if $mise {
    step "\nUpgrading mise plugins\n\n"
    ^mise plugins upgrade

    step "\n\nUpgrading outdated mise tools\n\n"
    ^mise upgrade
  }

  step $"\n\nChanging back to ($original_dir)"
  cd $original_dir
}

# Print a progress line in `>> X ...` style. Splits on newlines so multi-line
# input formats consistently.
def step [text: string]: nothing -> nothing {
  $text
  | split row "\n"
  | each {|line|
    if ($line | is-empty) {
      print -e ''
    } else {
      print -ne $'>> ($line) ...'
    }
  }
  | ignore
}
