#!/usr/bin/env bash
# Print tool names and versions from the commands passed as arguments.
# Usage: exec-versions pi claude
set -u
for cmd in "$@"; do
  path=$(command -v "$cmd" 2>/dev/null)
  if [[ -z $path ]]; then
    printf '%s\t\tnot installed\n' "$cmd"
    continue
  fi
  ver=$("$cmd" --version 2>&1 </dev/null | grep -m1 -oE '[0-9]+(\.[0-9]+)+[^ ]*' || true)
  printf '%s\t%s\n' "$cmd" "${ver:-unknown} ($path)"
done
