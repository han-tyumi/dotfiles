# Destination paths chezmoi deletes on every apply. Dropping an entry from the
# source state does not remove the target it already applied, so a target that
# must not survive on a machine is listed here.
.claude/skills/git-spice
.local/bin/github-mcp-server
# The sandbox-browser wrapper belonged to Codex's sandbox, which is no longer
# installed anywhere.
.local/bin/sandbox-browser
.claude/skills/sandbox-browser
.agents/skills/sandbox-browser
# Links dot_agents/ used to make into ~/.agents/skills, now published by the work
# layer's workAgentSkillMirror instead. Ungated this would delete exactly what
# that activation recreates, so it is scoped to a machine without the layer.
{{ if not (has "work" .layerList) }}
.agents/skills/agent-browser
.agents/skills/create-skill
.agents/skills/gh-stack
.agents/skills/git-worktree
{{ end }}
# Skills only the personal layer has a use for.
{{ if not (has "personal" .layerList) }}
.agents/skills/character
.agents/skills/steam
.agents/skills/tune-game
{{ end }}
# The deny-destructive guard was retired 2026-09-30; drop the applied copy everywhere.
.claude/hooks/deny-destructive.py
# Conductor was retired 2026-10 for Orca; drop its managed settings everywhere.
.conductor
# Codex, Qwen Code and CodeBurn were declared only by the work layer, and their
# configs were rendered by activations, which write real files rather than links.
# Retiring those activations left the last rendered copy behind with nothing to
# remove it. The gate keeps a machine that later installs one of these tools from
# losing a config this repo never wrote. Only the rendered configs are listed:
# Codex's sqlite history and Qwen's transcripts belong to the user, as does
# `~/.codex/hooks.json`, which Orca writes.
{{ if has "work" .layerList }}
.codex/config.toml
.codex/config.toml.bak
.qwen/settings.json
.qwen/settings.json.bak
.qwen/settings.json.backup
.config/codeburn/config.json
{{ end }}
# Enshrouded's RTSS cap comes from the gpu-profiles switcher; a declared copy
# would put 60 back on the 890M at every apply.
.config/rtss/profiles/enshrouded.exe.cfg
