  "appFontFamily": "PragmataPro",
  "terminalFontFamily": "PragmataPro Mono",
  "tabAutoGenerateTitle": true,
  "keepComputerAwakeWhileAgentsRun": true,
  "mobileEmulatorEnabled": false,
