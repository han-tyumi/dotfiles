{
  "launchers": {
    "battlenet": {
      "strategy": "cdp",
      "path": "C:\\Program Files\\Battle.net\\Battle.net.exe",
      "processPattern": "Battle.net*",
      "alsoStop": ["Agent"],
      "stopAfterExit": true,
      "debuggingPort": 9222,
      "installDb": "C:\\ProgramData\\Battle.net\\Agent\\product.db",
      "startArgs": ["--remote-debugging-port={port}", "--exec=\"launch_uid {id}\""],
      "targetUrlPattern": "resources://home*",
      "playSelector": "button.play-btn.play-action",
      "productSelector": ".play-selector-button",
      "playLabelPattern": "^play$"
    },
    "standalone": {
      "strategy": "direct"
    }
  },
  "games": {
    "wow-forever": {
      "launcher": "battlenet",
      "id": "wow_classic_beta",
      "productMatch": "Forever",
      "process": "WowB",
      "steam": {
        "name": "World of Warcraft: Forever",
        "steamGridDb": "World of Warcraft Classic"
      }
    },
    "clone-hero": {
      "launcher": "standalone",
      "exe": "%LOCALAPPDATA%\\Microsoft\\WinGet\\Packages\\CloneHeroTeam.CloneHero_Microsoft.Winget.Source_8wekyb3d8bbwe\\Standalone\\Clone Hero.exe",
      "steam": {
        "name": "Clone Hero",
        "steamGridDb": "Clone Hero"
      }
    }
  }
}
